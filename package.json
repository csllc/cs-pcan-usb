  "author": "cwalden@controls.com",
  "os": [
    "win32"
  ],
  "dependencies": {
    "@mapbox/node-pre-gyp": "^1.0.9",
    "bindings": "~1.2.1",
    "stream": "0.0.2"
  },
  "devDependencies": {
    "@csllc/j1939": "^1.1.1",
    "can-usb-com": "^4.0.2",
    "chai": "^4.3.6",
    "chai-events": "0.0.3",
