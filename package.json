{
  "name": "@csllc/cs-pcan-usb",
  "version": "0.4.0",
  "description": "PCAN-USB module for NodeJS",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "src/",
    "tools/pcan-sdk.js",
    "tools/fetch-deps.js",
    "tools/bundle-pcbusb.js",
    "binding.gyp",
    "prebuilds/"
  ],
  "license": "MIT",
  "author": "cwalden@controls.com",
  "os": [
    "darwin",
    "win32"
  ],
  "dependencies": {
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "chai": "^6.0.0",
    "chai-events": "0.0.3",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "mocha": "^11.0.0",
    "node-api-headers": "^1.9.0",
    "node-gyp": "^12.1.0",
    "prebuildify": "^6.0.0"
  },
  "scripts": {
    "install": "node-gyp-build",
    "fetch-deps": "node tools/fetch-deps.js",
    "build": "node-gyp build && node tools/bundle-pcbusb.js build/Release",
    "rebuild": "node-gyp rebuild && node tools/bundle-pcbusb.js build/Release",
    "prebuildify": "prebuildify --napi && node tools/bundle-pcbusb.js --prebuilds",
    "test": "mocha test",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csllc/cs-pcan-usb.git"
  },
  "gypfile": true,
  "publishConfig": {
    "access": "public"
  }
}
